{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nuxtjs",
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/recommendations/refresh-pool",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/titles/update-unreleased",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/titles/update-ongoing-series",
      "schedule": "0 4 * * *"
    }
  ]
}
